# Build context is the repo root. Never send secrets, VCS data or heavy local files.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
.git
.gitignore
**/node_modules
**/.venv
**/__pycache__
**/*.pyc
**/dist
logs
**/logs
tools/fixtures/audio
scenarios/*/audio/*
!scenarios/*/audio/manifest.json
scripts/verify/out
.idea
.vscode
.claude
*.mcp.json
.mcp.json
mcp.json
mcp-config*.json
