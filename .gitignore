skills-lock.json

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node and build output
node_modules/
dist/
build/

# Process logs and pid files (scripts/run_all.sh, scripts/run_v2.sh)
logs/

# Generated audio (text-to-speech cache of tools/smoke_feed.py)
tools/fixtures/audio/

