# Copy to .env (gitignored) at the repo root. Only MONGODB_URI is required.
# A blank value means "use the default". The few lines that are commented out are settings
# where an empty value is not the same as leaving the setting unset.
# The visualizer has its own files: visualizer/api/.env.example and visualizer/web/.env.example.

# --- MongoDB Atlas ---
# Connection string of the Atlas cluster (mongodb+srv://...). Required.
MONGODB_URI=
# Database name. Default: holdshort_v2
MONGODB_DB=
# Optional static connection string for one agent, e.g. MONGODB_URI_SAFETY (holdshort/access.py)
MONGODB_URI_SAFETY=

# --- Language model (holdshort/llm.py) ---
# vertex | anthropic | none. Default: vertex when VERTEX_PROJECT is set, anthropic when
# LLM_API_KEY is set, otherwise none (rule and template fallbacks only)
LLM_PROVIDER=
# Google Cloud project for Gemini on Vertex AI
VERTEX_PROJECT=
# Vertex AI region. Default: global
VERTEX_REGION=
# Path of a service-account key file for local runs; leave unset on Cloud Run
# GOOGLE_APPLICATION_CREDENTIALS=
# API key, only for LLM_PROVIDER=anthropic
LLM_API_KEY=
# Model for every task, only for LLM_PROVIDER=anthropic
LLM_MODEL=
# Model per task. Default on Vertex AI: gemini-4-argon
LLM_MODEL_PARSE=
LLM_MODEL_ADVISOR=
LLM_MODEL_AUDIT=
# Thinking level per task: off | low | medium | high. Defaults: parse low, advisor medium, audit high
LLM_THINKING_PARSE=
LLM_THINKING_ADVISOR=
LLM_THINKING_AUDIT=
# Hard time limit in seconds for labelling one radio call. Default: 6
LLM_PARSE_TIMEOUT_S=
# Hard time limit in seconds for drafting one proposal. Default: 20
LLM_ADVISOR_TIMEOUT_S=

# --- Speech (ElevenLabs) ---
# API key for speech-to-text, voice isolation and text-to-speech
ELEVENLABS_API_KEY=
# true turns real speech on; otherwise the feed's text and placeholder tones are used
VOICE_ENABLED=
# Seconds to wait for speech-to-text or voice isolation before falling back to the feed's text. Default: 120
ELEVENLABS_TIMEOUT_S=
# off skips voice isolation before speech-to-text (it adds seconds on the live path)
VOICE_ISOLATION=
# Speech-to-text model. Default: scribe_v1
ELEVENLABS_STT_MODEL=
# Text-to-speech model. Default: eleven_multilingual_v2
ELEVENLABS_MODEL=
# Voice id for the calls Phylax Tower speaks (holdshort/speaker)
ELEVENLABS_VOICE_ALERT=
# Voice id per speaker for the feeds, e.g. ELEVENLABS_VOICE_TOWER (tools/smoke_feed.py, simulator)
ELEVENLABS_VOICE_TOWER=

# --- Tower API ---
# Extra allowed browser origins, comma separated (localhost is always allowed)
CORS_ORIGINS=
# If set, every /ingest/* call must send it as the X-Ingest-Key header
INGEST_KEY=
# Seconds before an object that is no longer reported disappears. Default: 120
OBJECT_TTL_S=

# --- Per-agent Atlas users (holdshort/identity/README.md) ---
# generated turns them on; anything else means every agent uses MONGODB_URI
AGENT_IDENTITIES=
# Seconds an agent waits at start-up for its new user. Default: 20
AGENT_IDENTITY_WAIT_S=
# Lifetime of a generated user in hours. Default: 6
AGENT_USER_TTL_HOURS=
# Atlas project and cluster the users are created in
ATLAS_PROJECT_ID=
ATLAS_CLUSTER_NAME=
# Atlas Admin API credentials: either an API key pair or a service account
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=

# --- Tracing ---
# Turns on LangSmith tracing of the agent graphs
LANGSMITH_API_KEY=
# LangSmith project name
# LANGSMITH_PROJECT=

# --- Simulator and smoke feed ---
# Base URL of the tower they feed. Default: http://localhost:8000
# TOWER_API=
# Simulator speech engine: elevenlabs | say | tone. Default: chosen automatically
SIM_TTS=
# Token that protects the simulator's control port. Default: generated at start-up
SIM_CONTROL_TOKEN=

# Read from the process environment only, not from this file: HOLDSHORT_ENV (path of another
# .env file to load), PORT (API port in a container), HOLDSHORT_LOGS (log folder of the
# scripts), HOLDSHORT_TEST_DB (database name for the tests).
