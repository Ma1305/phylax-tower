MONGODB_URI=
MONGODB_DB=holdshort_v2
# Language models (holdshort/llm.py). LLM_PROVIDER: vertex | anthropic | none
# (default: vertex when VERTEX_PROJECT is set, anthropic when LLM_API_KEY is set, else none).
LLM_PROVIDER=
VERTEX_PROJECT=
VERTEX_REGION=global
# Service-account key file for local runs; leave blank on Cloud Run (ambient credentials).
GOOGLE_APPLICATION_CREDENTIALS=
# Only for LLM_PROVIDER=anthropic
LLM_API_KEY=
# Per-task model and thinking level (off|low|medium|high; "minimal" is rejected by
# gemini-4-argon). Defaults: gemini-4-argon with parse=low, advisor=medium, audit=high.
LLM_MODEL_PARSE=
LLM_THINKING_PARSE=
LLM_MODEL_ADVISOR=
LLM_THINKING_ADVISOR=
LLM_MODEL_AUDIT=
LLM_THINKING_AUDIT=
# Hard timeouts in seconds (defaults 6 and 20; the audit uses 60)
LLM_PARSE_TIMEOUT_S=
LLM_ADVISOR_TIMEOUT_S=
ELEVENLABS_API_KEY=
VOICE_ENABLED=false

# Optional ElevenLabs overrides (blank = defaults in scripts/audio/generate.py)
ELEVENLABS_VOICE_TOWER=
ELEVENLABS_VOICE_AC8646=
ELEVENLABS_VOICE_TRUCK1=
ELEVENLABS_MODEL=
# Voice alert service (holdshort.voice_alert): voice for spoken STOPs; 1 = also play on this host
ELEVENLABS_VOICE_ALERT=
VOICE_ALERT_PLAY=

# Optional: LangSmith tracing of the agent graphs (off unless the key is set)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hold-short

# Optional: per-agent Atlas users generated on demand (holdshort/identity/README.md).
# Used ONLY when AGENT_IDENTITIES=generated (default off), even if the ATLAS_* values are set.
# Off = every agent uses MONGODB_URI (or MONGODB_URI_<AGENT>).
AGENT_IDENTITIES=
# Seconds an agent's startup waits for its new user before staying on the shared connection
AGENT_IDENTITY_WAIT_S=20
ATLAS_PROJECT_ID=
ATLAS_CLUSTER_NAME=
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=
AGENT_USER_TTL_HOURS=6
