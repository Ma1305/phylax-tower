MONGODB_URI=
MONGODB_DB=holdshort_v2
LLM_API_KEY=
ELEVENLABS_API_KEY=
VOICE_ENABLED=false

# Optional ElevenLabs overrides (blank = defaults in scripts/audio/generate.py)
ELEVENLABS_VOICE_TOWER=
ELEVENLABS_VOICE_AC8646=
ELEVENLABS_VOICE_TRUCK1=
ELEVENLABS_MODEL=
# Voice alert service (holdshort.voice_alert): voice for spoken STOPs; 1 = also play on this host
ELEVENLABS_VOICE_ALERT=
VOICE_ALERT_PLAY=

# Optional: LangSmith tracing of the agent graphs (off unless the key is set)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hold-short

# Optional: per-agent Atlas users generated on demand (holdshort/identity/README.md).
# Unset = every agent uses MONGODB_URI (or MONGODB_URI_<AGENT>).
ATLAS_PROJECT_ID=
ATLAS_CLUSTER_NAME=
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=
AGENT_USER_TTL_HOURS=6
