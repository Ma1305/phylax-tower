# Settings of the visualizer API. Copy to .env in this folder (gitignored), or link the
# repo's .env here. A blank value means "use the default".
# Connection string for the visualizer (a read-only Atlas user is enough)
VIZ_MONGODB_URI=
# Connection string used when VIZ_MONGODB_URI is blank
MONGODB_URI=
# Database name. Default: holdshort_v2
MONGODB_DB=
# Extra allowed browser origins, comma separated (localhost is always allowed)
CORS_ORIGINS=
# Port for `python app.py`. Default: 8100
# PORT=
